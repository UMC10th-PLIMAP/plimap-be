# 로컬 개발용으로만 이 파일을 .env로 복사합니다.
# Docker Compose는 .env를 자동으로 읽습니다. Spring Boot를 IDE 또는 셸에서
# 실행할 때도 같은 변수를 설정합니다. 생성된 .env 파일은 절대 커밋하지 않습니다.
#
# PUBLIC_BASE_URL과 TEST_TOKEN_ISSUE_KEY는 Dev 전용 설정입니다.
# 로컬 .env가 아니라 Dev 배포 환경과 GCP Secret Manager에서 관리합니다.

# 로컬 PostgreSQL/PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plimap_local_db
DB_USERNAME=plimap
DB_PASSWORD=plimap1234

# 로컬 Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 로컬 API 호출을 허용할 Origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.*:[*],https://192.168.*:[*]

# OAuth 로그인 완료 후 이동할 수 있는 로컬 프론트 Origin.
OAUTH_ALLOWED_FRONTEND_ORIGINS=http://localhost:5173

# 로컬 전용 JWT 서명 키.
JWT_SECRET=

# 로컬 OAuth 자격 증명.
KAKAO_REST_API_KEY=
KAKAO_REST_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 탈퇴 시 소셜 연결 끊기.
# KAKAO_ADMIN_KEY: 카카오 앱 어드민 키. 비워 두면 카카오 연결 끊기만 실패하고 탈퇴는 진행됩니다.
# APPLE_PRIVATE_KEY: App Store Connect에서 받은 .p8 키 내용(PEM). 한 줄로 넣을 때는 줄바꿈을 \n으로 씁니다.
# SOCIAL_TOKEN_ENCRYPTION_KEY: 필수. openssl rand -base64 32로 만든 값입니다.
KAKAO_ADMIN_KEY=
APPLE_PRIVATE_KEY=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# 로컬 YouTube Data API 키.
YOUTUBE_API_KEY=

# 로컬 프로필 이미지 업로드 테스트용 Supabase 프로젝트.
# 본인 Supabase 프로젝트에 profile-images(public) 버킷을 만들고 아래 값을 채웁니다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PROFILE_IMAGE_STORAGE_PROVIDER=supabase
PROFILE_IMAGE_BUCKET=profile-images

# 선택적 시작 진단. 기본 false, enabled=true인 비교군끼리만 시간을 비교합니다.
PLIMAP_STARTUP_MONITORING_ENABLED=false
# 시작 단계 버퍼 상한(64~8192)과 출력할 가장 느린 단계 수(1~50).
PLIMAP_STARTUP_MONITORING_BUFFER_CAPACITY=2048
PLIMAP_STARTUP_MONITORING_MAX_STEPS=10

# Docker 이미지의 애플리케이션 CDS archive 사용 여부. 기본 true.
# false도 JDK 기본 CDS는 유지합니다. bootRun에는 적용되지 않습니다.
PLIMAP_APP_CDS_ENABLED=true
